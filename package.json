{
  "name": "urkundenwerk",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @urkundenwerk/web dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @urkundenwerk/web test:e2e",
    "build": "pnpm --filter @urkundenwerk/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.55.0"
  }
}
