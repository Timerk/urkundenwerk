{
  "name": "urkundenwerk",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @urkundenwerk/web dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @urkundenwerk/web test:e2e",
    "build": "pnpm --filter @urkundenwerk/web build",
    "start": "pnpm --filter @urkundenwerk/web start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:types": "node scripts/db-types.mjs",
    "db:env": "node scripts/supabase-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
