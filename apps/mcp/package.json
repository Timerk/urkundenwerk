{
  "name": "@urkundenwerk/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that drafts, validates, and exports Urkundenwerk documents as the signed-in user",
  "type": "module",
  "bin": {
    "urkundenwerk-mcp-server": "./bin/urkundenwerk-mcp-server.mjs"
  },
  "scripts": {
    "start": "node bin/urkundenwerk-mcp-server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "2.119.1",
    "@urkundenwerk/core": "workspace:*",
    "@urkundenwerk/render": "workspace:*",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "vitest": "catalog:",
    "xmlbuilder2": "^4.0.3"
  }
}
