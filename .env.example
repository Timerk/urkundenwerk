# Copy the variables the web app needs into apps/web/.env.local.
# For the local Supabase stack, `pnpm db:env` writes that file for you from
# `supabase status`. Never commit real values.

# Supabase project URL and publishable key (`sb_publishable_…`). Both are
# public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local registration defaults to on. Set false for the hosted demo and
# disable sign-ups in Supabase Auth as well.
NEXT_PUBLIC_SIGNUP_ENABLED=
# Server only. Enables one-click login for the provisioned shared accounts.
DEMO_LOGIN_PASSWORD=

# AI explanations and contract extraction (server only, see
# docs/adr/0007-llm-port-and-adapters.md and
# docs/adr/0009-llm-extraction-with-verified-citations.md).
# Put your own key in apps/web/.env.local, which Git ignores. Never commit it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# `anthropic`, `openai`, `fake` (scripted answers, no network), or `disabled`.
# Defaults to the provider whose key is set (Anthropic first) and to
# `disabled` without a key.
AI_PROVIDER=
# Model ids per task. Defaults: claude-haiku-5-5 and claude-opus-5-5 for
# Anthropic, gpt-6-luna and gpt-6.1-terra for OpenAI.
AI_MODEL_EXPLAIN=
AI_MODEL_EXTRACT=
# Deadline per model call in milliseconds (1000 to 120000, default 20000).
AI_TIMEOUT_MS=
# Deadline per extraction call in milliseconds (10000 to 300000, default 120000).
AI_EXTRACT_TIMEOUT_MS=
