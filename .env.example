# Copy the variables the web app needs into apps/web/.env.local.
# For the local Supabase stack, `pnpm db:env` writes that file for you from
# `supabase status`. Never commit real values.

# Supabase project URL and publishable key (`sb_publishable_…`). Both are
# public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for server-side integrations. Never expose these to the browser.
# The Supabase secret key (`sb_secret_…`) bypasses row-level security.
SUPABASE_SECRET_KEY=

# AI explanations (server only, see docs/adr/0007-llm-port-and-adapters.md).
# Put your own key in apps/web/.env.local, which Git ignores. Never commit it.
ANTHROPIC_API_KEY=
# `anthropic`, `fake` (scripted answers, no network), or `disabled`.
# Defaults to `anthropic` when a key is set and to `disabled` otherwise.
AI_PROVIDER=
# Model ids per task. Defaults: claude-haiku-5-5 and claude-opus-5-5.
AI_MODEL_EXPLAIN=
AI_MODEL_EXTRACT=
# Deadline per model call in milliseconds (1000 to 120000, default 20000).
AI_TIMEOUT_MS=
