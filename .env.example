# Copy the variables the web app needs into apps/web/.env.local.
# For the local Supabase stack, `pnpm db:env` writes that file for you from
# `supabase status`. Never commit real values.

# Supabase project URL and publishable key (`sb_publishable_…`). Both are
# public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for server-side integrations. Never expose these to the browser.
# The Supabase secret key (`sb_secret_…`) bypasses row-level security.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
